# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored -- never commit your real key.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Model used by Scout, the video curator, and the voice judge.
# Run check_setup.py to see which models your key can call. claude-sonnet-5
# is cheaper and faster if you want to trade some quality for cost here.
ANTHROPIC_MODEL=claude-opus-5

# Optional. Model used by the Viral agent for drafting, since draft quality
# matters most there. Keep this on the strongest model.
ANTHROPIC_WRITER_MODEL=claude-opus-5

# Optional. Seconds to sleep between back-to-back model calls. 0 is right on
# Anthropic -- the SDK already backs off and retries rate limits itself.
LLM_CALL_PACING_SECONDS=0

# --- LinkedIn auto-posting (used by the Viral and Video agents) ---
# The agents can auto-post to the Metis LinkedIn page. They DEFAULT TO DRY RUN:
# nothing is posted until you set LINKEDIN_DRY_RUN=false. Getting a token is a
# one-time manual step (LinkedIn developer app + "Community Management API"
# product for the organization page + OAuth). See README.
# App credentials, used only by linkedin_auth.py to fetch a token. From your
# LinkedIn developer app (see LINKEDIN_SETUP.md). Not needed once you have a token.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URL" in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
# Filled in for you by:  python linkedin_auth.py
LINKEDIN_ACCESS_TOKEN=
# Who the post is authored as. For the Metis page (an organization):
#   urn:li:organization:xxxx
# (A personal profile would be urn:li:person:xxxx.)
LINKEDIN_ACTOR_URN=
# Leave true until you have a real token and want posts to go live.
LINKEDIN_DRY_RUN=true
# Optional. LinkedIn versioned-API month, YYYYMM. Defaults to a recent version.
LINKEDIN_API_VERSION=202405
